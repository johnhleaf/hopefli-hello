APP_ENV=production
APP_PORT=8097
APP_BASE_URL=https://hello.hopefli.se
SECRET_KEY=CHANGE_ME_GENERATED
DATABASE_URL=postgresql+psycopg2://hopefli:CHANGE_ME_DB_PASSWORD@db:5432/hopefli_intranet
REDIS_URL=redis://redis:6379/0
SESSION_COOKIE_NAME=hopefli_hello_session
SESSION_LIFETIME_HOURS=10

HOPEFLI_SSO_ISSUER=https://cms.hopefli.se
HOPEFLI_SSO_CLIENT_ID=hopefli-hello
HOPEFLI_SSO_CLIENT_SECRET=CHANGE_ME
HOPEFLI_SSO_REDIRECT_URI=https://hello.hopefli.se/auth/callback

CMS_URL=https://cms.hopefli.se
EVENT_URL=https://cms.hopefli.se/events
BOOKSTACK_URL=https://docs.hopefli.se
PLAY_URL=https://play.hopefli.se

BREAK_GLASS_ENABLED=false
BREAK_GLASS_USERNAME=local-recovery
BREAK_GLASS_PASSWORD_HASH=

GITHUB_REPO=
GITHUB_BRANCH=main

SSO_CONFIG_PATH=/config/sso.json
